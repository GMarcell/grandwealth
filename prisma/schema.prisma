generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TrialRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role          @default(USER)
  plan          Plan          @default(FREE)
  // Subscription state — only meaningful when plan is PRO. Admins manage
  // these fields manually today; the shape mirrors a typical billing
  // provider (status + period end) so an online gateway can be wired in
  // later without another migration.
  subscriptionStatus SubscriptionStatus?
  currentPeriodEnd   DateTime?
  // True while Pro access comes from a trial granted by an administrator
  // (after the user requested one from Settings). Cleared when an admin
  // grants Pro manually or when the trial lapses (the account is swept back
  // to FREE) — paid subscriptions are never trials. Trials don't count
  // toward MRR.
  isTrial       Boolean       @default(false)
  suspended     Boolean       @default(false)
  budgetStartDay Int           @default(1)
  // Global switch: when true, a budget's unused amount automatically carries
  // over to the next month. Purely a budgeting concept — it never creates
  // income or transactions, so it does not affect net wealth.
  carryOverEnabled Boolean     @default(true)
  transactions         Transaction[]
  goldDeposits         GoldDeposit[]
  stocks               Stock[]
  categories           Category[]
  budgets              Budget[]
  recurringTransactions RecurringTransaction[]
  monthlyAnalyses       MonthlyAnalysis[]
  bankSavings           BankSaving[]
  savingsGoals          SavingsGoal[]
  loans                 Loan[]
  dividends             Dividend[]
  accounts              Account[]
  sessions              Session[]
  trialRequests         TrialRequest[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// A user's request to be put on the Pro trial.
///
/// Trials are admin-managed: the user asks for one from Settings, an
/// administrator approves it (which grants PRO for `PRO_TRIAL_DAYS`), and the
/// account drops back to FREE automatically when that period ends — see
/// `expireLapsedTrials` in src/lib/trial.ts. At most one trial is granted per
/// account, tracked by the APPROVED row.
model TrialRequest {
  id           String             @id @default(cuid())
  status       TrialRequestStatus @default(PENDING)
  message      String?            // optional note from the user
  decisionNote String?            // optional note from the admin
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Id (not a relation) of the admin who decided the request — audit only.
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Float
  description String
  date        DateTime        @default(now())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, description])
  @@index([userId, type, date])
}

enum RuleType {
  NEED
  WANT
  SAVINGS
}

model Category {
  id        String    @id @default(cuid())
  name      String
  type      String    // INCOME or EXPENSE
  color     String    @default("#6366f1")
  ruleType  RuleType? // NEED, WANT, or SAVINGS for 50/30/20 budget rule
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, userId])
}

model Budget {
  id              String   @id @default(cuid())
  categoryName    String
  amount          Float
  month           String   // format: "YYYY-MM"
  rolloverCap     Float?   // maximum carry-over allowed, null means no cap
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([categoryName, month, userId])
}

enum GoldType {
  BUY
  SELL
}

model GoldDeposit {
  id           String   @id @default(cuid())
  type         GoldType
  weightGram   Float
  pricePerGram Float
  totalAmount  Float
  date         DateTime @default(now())
  notes        String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, notes])
  @@index([userId, type, date])
}

model Stock {
  id               String    @id @default(cuid())
  symbol           String
  name             String
  quantity         Int
  buyPrice         Float
  currentPrice     Float?
  lastPriceUpdated DateTime?
  date             DateTime  @default(now())
  notes            String?
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dividends        Dividend[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, symbol])
  @@index([userId, name])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id           String              @id @default(cuid())
  type         TransactionType
  category     String
  amount       Float
  description  String
  frequency    RecurringFrequency
  startDate    DateTime
  endDate      DateTime?
  nextDate     DateTime
  active       Boolean             @default(true)
  savingsGoalId String?
  savingsGoal  SavingsGoal?        @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([savingsGoalId])
}

enum SavingType {
  DEPOSIT
  WITHDRAWAL
}

model BankSaving {
  id          String     @id @default(cuid())
  type        SavingType
  accountName String
  amount      Float
  date        DateTime   @default(now())
  notes       String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, date])
  @@index([userId, accountName])
  @@index([userId, notes])
}

model SavingsGoal {
  id                   String                 @id @default(cuid())
  name                 String
  targetAmount         Float
  savedAmount          Float                  @default(0)
  targetDate           DateTime?
  color                String                 @default("#6366f1")
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringTransactions RecurringTransaction[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([userId])
}

model Loan {
  id               String   @id @default(cuid())
  name             String
  principal        Float
  remainingBalance Float
  interestRate     Float?
  monthlyPayment   Float?
  startDate        DateTime
  notes            String?
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model Dividend {
  id        String    @id @default(cuid())
  stockId   String
  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime  @default(now())
  notes     String?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, date])
  @@index([stockId])
}

model MonthlyAnalysis {
  id              String   @id @default(cuid())
  month           String   // format: "YYYY-MM"
  summary         String   // AI-generated analysis text (Markdown)
  totalIncome     Float
  totalExpenses   Float
  netSavings      Float
  savingsRate     Float    // percentage
  topCategory     String?  // top spending category
  topCategoryAmount Float?
  stockValue      Float?   // total stock portfolio value at month end
  goldValue       Float?   // total gold holdings value at month end
  budgetCount     Int      @default(0)  // number of budgets tracked
  overBudgetCount Int      @default(0)  // number of budgets exceeded
  transactionCount Int     @default(0)
  rawData         String   // JSON: snapshot of underlying data used
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([month, userId])
}
